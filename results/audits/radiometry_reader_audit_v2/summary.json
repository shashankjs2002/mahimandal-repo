    "notebook_sha256": "690d9a08df8b0dce9b12f8a4047dbdd827c874877ac3e3c411f58cd1120f0856",
    "definitions": {
      "read_l": {
        "cell_index_zero_based": 7,
        "source": "def read_l(href, win):\n    with rasterio.open(href) as src:\n        return src.read(1, window=win)"
      },
      "read_s2": {
        "cell_index_zero_based": 7,
        "source": "def read_s2(href, crs, hr_tf, resampling):\n    with rasterio.open(href) as src:\n        with WarpedVRT(src, crs=crs, transform=hr_tf, width=HR_SIZE, height=HR_SIZE,\n                       resampling=resampling, src_nodata=0, nodata=0) as v:\n            return v.read(1)"
      },
      "build_patch": {
        "cell_index_zero_based": 7,
        "source": "def build_patch(sc, sd, ancillary, i, j, required_priority_region=None):\n    try:\n        with rio_env():\n            col0, row0 = i * LR_SIZE, j * LR_SIZE\n            tf, crs = sc['tf'], sc['crs']\n            x_ul = tf.c + tf.a * col0 + tf.b * row0\n            y_ul = tf.f + tf.d * col0 + tf.e * row0\n            lr_tf = Affine(LR_RES, 0, x_ul, 0, -LR_RES, y_ul)\n            hr_tf = Affine(HR_RES, 0, x_ul, 0, -HR_RES, y_ul)\n            win = Window(col0, row0, LR_SIZE, LR_SIZE)\n            cx = x_ul + LR_SIZE * LR_RES / 2\n            cy = y_ul - LR_SIZE * LR_RES / 2\n            clon, clat = Transformer.from_crs(\n                crs, 4326, always_xy=True\n            ).transform(cx, cy)\n            state_or_ut = state_or_ut_at(clon, clat)\n            region = priority_region(state_or_ut)\n            if required_priority_region and region != required_priority_region:\n                return dict(ok=False, why=f'outside_{required_priority_region}')\n\n            # Cheap tests first: only QA + SCL are read.\n            qa = retry(lambda: read_l(sc['hrefs']['qa_pixel'], win))\n            l_clear = (qa & 31) == 0\n            if l_clear.mean() < MIN_CLEAR:\n                return dict(ok=False, why='cloud_landsat')\n            scl = retry(lambda: read_s2(\n                sd['hrefs']['SCL'], crs, hr_tf, Resampling.nearest\n            ))\n            s_clear = np.isin(scl, S2_CLEAR_SCL)\n            joint = (\n                np.repeat(np.repeat(l_clear, FACTOR, 0), FACTOR, 1) & s_clear\n            ).mean()\n            if joint < MIN_CLEAR:\n                return dict(ok=False, why='cloud_joint')\n            water = float((scl == 6).mean())\n            if water > MAX_WATER_FRAC:\n                return dict(ok=False, why='water')\n\n            l_dn = np.stack([\n                retry(lambda k=k: read_l(sc['hrefs'][k], win))\n                for k in L_ASSETS\n            ])\n            s_dn = np.stack([\n                retry(lambda k=k: read_s2(\n                    sd['hrefs'][k], crs, hr_tf, Resampling.bilinear\n                )) for k in S_ASSETS\n            ])\n            if (l_dn == 0).any(0).mean() > 0.001 or (s_dn == 0).any(0).mean() > 0.001:\n                return dict(ok=False, why='nodata')\n            lr = np.clip(\n                l_dn.astype('float32') * 0.275 - 2000.0, 0, 10000\n            ).round().astype('int16')\n            hr = np.clip(\n                s_dn.astype('float32') - sd['offset'], 0, 10000\n            ).astype('int16')\n\n            hr_ds = hr.astype('float32').reshape(\n                4, LR_SIZE, FACTOR, LR_SIZE, FACTOR\n            ).mean((2, 4))\n            c_red, c_nir = corr(hr_ds[2], lr[2]), corr(hr_ds[3], lr[3])\n\n            esri_labels = retry(lambda: read_esri_landcover_2025(\n                crs, hr_tf, HR_SIZE, HR_SIZE,\n            ))\n            try:\n                cover = esri_landcover_percentages(esri_labels)\n            except ValueError:\n                return dict(ok=False, why='esri2025_landcover_missing')\n            if cover.get('clouds', 0.0) > MAX_ESRI_CLOUD_PCT:\n                return dict(ok=False, why='esri2025_landcover_cloud')\n\n            historical_labels = retry(lambda: read_mosaic(\n                ancillary['worldcover'], crs, hr_tf, HR_SIZE, HR_SIZE,\n                Resampling.nearest,\n            ))\n            historical_labels = np.where(\n                np.isfinite(historical_labels), np.rint(historical_labels), 0\n            ).astype(np.uint8)\n            try:\n                historical_cover = worldcover_percentages(historical_labels)\n            except ValueError:\n                return dict(ok=False, why='worldcover_missing')\n            elevation = retry(lambda: read_mosaic(\n                ancillary['dem'], crs, lr_tf, LR_SIZE, LR_SIZE,\n                Resampling.bilinear,\n            ))\n            try:\n                terrain = terrain_statistics(elevation, LR_RES)\n            except ValueError:\n                return dict(ok=False, why='dem_missing')\n            landscape = classify_esri_landscape(cover, terrain)\n            nir_threshold = (\n                MIN_NIR_STD_ALPINE if landscape == 'alpine' else MIN_NIR_STD\n            )\n            correlation_threshold = (\n                MIN_CORR_ALPINE if landscape == 'alpine' else MIN_CORR\n            )\n            if hr[3].std() < nir_threshold:\n                return dict(ok=False, why=f'flat_{landscape}')\n            if not (\n                c_red >= correlation_threshold and c_nir >= correlation_threshold\n            ):\n                return dict(ok=False, why=f'low_corr_{landscape}')\n\n            l_it, s_it = sc['item'], sd['item']\n            tile = s_it.properties.get('s2:mgrs_tile', 'NA')\n            pid = f\"{l_it.id}__{tile}_{s_it.datetime:%Y%m%d}__{i}_{j}\"\n            equal_x, equal_y = equal_area_xy(clon, clat)\n            geography = geographic_stratum(clat)\n            row = dict(\n                pair_id=pid, landsat_id=l_it.id, sentinel_id=s_it.id,\n                platform=l_it.properties['platform'],\n                s2_platform=s_it.properties.get('platform'), s2_tile=tile,\n                date_L=f'{l_it.datetime:%Y-%m-%d}',\n                date_S=f'{s_it.datetime:%Y-%m-%d}',\n                day_gap=abs((l_it.datetime.date() - s_it.datetime.date()).days),\n                time_diff_min=round(abs(\n                    (s_it.datetime - l_it.datetime).total_seconds()\n                ) / 60, 1),\n                cloud_L=l_it.properties.get('eo:cloud_cover'),\n                cloud_S=s_it.properties.get('eo:cloud_cover'),\n                crs=str(crs), ul_x=x_ul, ul_y=y_ul,\n                center_lon=round(clon, 6), center_lat=round(clat, 6),\n                equal_area_x_m=round(equal_x, 2),\n                equal_area_y_m=round(equal_y, 2),\n                clear_frac=round(float(joint), 4),\n                water_frac=round(water, 4), corr_red=round(c_red, 4),\n                corr_nir=round(c_nir, 4), nir_std=round(float(hr[3].std()), 1),\n                landscape_class=landscape,\n                geographic_stratum=geography,\n                state_or_ut=state_or_ut,\n                priority_region=region,\n                landcover_year=ESRI_LANDCOVER_YEAR,\n                landcover_source='Esri Impact Observatory Sentinel-2 10m Annual LULC',\n                landcover_service=ESRI_LANDCOVER_SERVICE,\n                worldcover_year=2021,\n                worldcover_source='ESA WorldCover 2021 v200 historical comparison',\n                dem_source='Copernicus DEM GLO-30',\n                **{f'esri2025_{name}_pct': round(value, 4)\n                   for name, value in cover.items()},\n                **{f'wc2021_{name}_pct': round(value, 4)\n                   for name, value in historical_cover.items()},\n                **{name: round(value, 4) for name, value in terrain.items()},\n            )\n            tags = dict(\n                landsat=l_it.id, sentinel=s_it.id,\n                landscape=landscape, landcover='Esri_2025',\n                worldcover_comparison='2021_v200', state_or_ut=state_or_ut,\n            )\n            return dict(\n                ok=True, row=row, preview=(lr, hr), cell=(i, j),\n                low=lr, high=hr, crs=crs, low_transform=lr_tf,\n                high_transform=hr_tf, tags=tags,\n            )\n    except Exception as error:\n        return dict(ok=False, why='read_error', err=str(error)[:160])"
      }
    },
